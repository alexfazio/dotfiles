# Custom whitelist - paths protected from mo clean

# Preserves app window positions, unsaved documents, scroll positions
~/Library/Saved Application State/*

# Pre-commit hook environments - slow to rebuild
~/.cache/pre-commit/*

# Alfred workflow custom data
~/Library/Caches/com.runningwithcrayons.Alfred/*

# Developer package caches
~/.cache/uv/*
~/Library/Caches/Homebrew/*
~/.bun/install/cache/*

# App caches/state expensive to rebuild
~/Library/Logs/Claude/*
~/Library/Application Support/coreMLCache/*
~/Library/Application Support/Cursor/CachedData/*

# Slack caches - avoid full re-sync/re-download on next launch
~/Library/Application Support/Slack/*
